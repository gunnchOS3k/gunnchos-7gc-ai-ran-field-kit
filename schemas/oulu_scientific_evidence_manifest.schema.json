{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oulu_scientific_evidence_manifest.schema.json",
  "title": "OuluScientificEvidenceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_version",
    "repository_commit",
    "causal_communication_tests",
    "control_action_effect_tests",
    "algorithm_fidelity_tests",
    "algorithms_implemented",
    "baseline_matrix",
    "scenario_matrix",
    "abstraction_matrix",
    "objective_matrix",
    "seed_matrix",
    "generalization_matrix",
    "robustness_matrix",
    "interpretability_outputs",
    "statistical_outputs",
    "generated_figures",
    "generated_tables",
    "raw_result_checksums",
    "paper_result_references",
    "clean_reproduction_report",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "environment_version": {"type": "string"},
    "repository_commit": {"type": "string", "minLength": 7},
    "causal_communication_tests": {"type": "object"},
    "control_action_effect_tests": {"type": "object"},
    "algorithm_fidelity_tests": {"type": "object"},
    "algorithms_implemented": {"type": "array", "items": {"type": "string"}},
    "baseline_matrix": {"type": "object"},
    "scenario_matrix": {"type": "object"},
    "abstraction_matrix": {"type": "object"},
    "objective_matrix": {"type": "object"},
    "seed_matrix": {"type": "object"},
    "generalization_matrix": {"type": "object"},
    "robustness_matrix": {"type": "object"},
    "interpretability_outputs": {"type": "object"},
    "statistical_outputs": {"type": "object"},
    "generated_figures": {"type": "array"},
    "generated_tables": {"type": "array"},
    "raw_result_checksums": {"type": "object"},
    "paper_result_references": {"type": "array"},
    "clean_reproduction_report": {"type": "object"},
    "status": {
      "type": "string",
      "enum": [
        "GATE4_OULU_FUNCTIONAL_SCAFFOLD_PASS",
        "GATE4_OULU_SCIENTIFIC_EVIDENCE_PENDING",
        "GATE4_OULU_SCIENTIFIC_EVIDENCE_PASS",
        "OULU_ENV_CAUSALITY_PENDING",
        "OULU_DIAL_FIDELITY_PENDING",
        "OULU_QMIX_FIDELITY_PENDING",
        "OULU_BASELINE_MATRIX_INCOMPLETE",
        "OULU_GENERALIZATION_INCOMPLETE",
        "OULU_ROBUSTNESS_INCOMPLETE",
        "OULU_STATISTICS_INCOMPLETE",
        "OULU_INTERPRETABILITY_INCOMPLETE",
        "OULU_MANUSCRIPT_RESULTS_INCOMPLETE"
      ]
    },
    "pending_states": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nvidia_aerial_depth_manifest.schema.json",
  "title": "NvidiaAerialDepthManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "standards_traceable_nr_path",
    "external_reference_vectors",
    "nr_ldpc_path",
    "exact_modulation",
    "usable_soft_llr",
    "scrambling_and_rate_matching",
    "configurable_ofdm_numerology",
    "channel_estimation_and_mimo",
    "scheduler_depth",
    "cuda_baseband_components",
    "cpu_gpu_orchestration",
    "real_time_deadline_model",
    "fault_handling",
    "profiling_harness",
    "controlled_optimization_studies",
    "fapi_fronthaul_validation",
    "upstream_contribution",
    "ci_quality",
    "clean_reproduction",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "repository_commit": {"type": "string", "minLength": 7},
    "standards_traceable_nr_path": {"type": "object"},
    "external_reference_vectors": {"type": "object"},
    "nr_ldpc_path": {"type": "object"},
    "exact_modulation": {"type": "object"},
    "usable_soft_llr": {"type": "object"},
    "scrambling_and_rate_matching": {"type": "object"},
    "configurable_ofdm_numerology": {"type": "object"},
    "channel_estimation_and_mimo": {"type": "object"},
    "scheduler_depth": {"type": "object"},
    "cuda_baseband_components": {"type": "object"},
    "cpu_gpu_orchestration": {"type": "object"},
    "real_time_deadline_model": {"type": "object"},
    "fault_handling": {"type": "object"},
    "profiling_harness": {"type": "object"},
    "controlled_optimization_studies": {"type": "object"},
    "fapi_fronthaul_validation": {"type": "object"},
    "upstream_contribution": {"type": "object"},
    "ci_quality": {"type": "object"},
    "clean_reproduction": {"type": "object"},
    "educational_path_separated": {"type": "boolean"},
    "status": {
      "type": "string",
      "enum": [
        "GATE4_NVIDIA_EDUCATIONAL_CPU_PASS",
        "GATE4_NVIDIA_NR_REFERENCE_PATH_PASS",
        "GATE4_NVIDIA_CUDA_IMPLEMENTATION_READY",
        "GATE4_NVIDIA_GPU_MEASUREMENT_PENDING",
        "GATE4_NVIDIA_AERIAL_DEPTH_PENDING",
        "GATE4_NVIDIA_AERIAL_DEPTH_PASS",
        "BLOCKED_HARDWARE"
      ]
    },
    "pending_states": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "classification"
        ]
      }
    }
  }
}

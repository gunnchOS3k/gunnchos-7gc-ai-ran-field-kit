{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate1_post_merge_findings.schema.json",
  "title": "Gate1PostMergeFinding",
  "type": "object",
  "required": [
    "finding_id",
    "severity",
    "category",
    "summary",
    "status"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "mitigated",
        "accepted_risk",
        "closed"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation": {
      "type": "string"
    }
  }
}

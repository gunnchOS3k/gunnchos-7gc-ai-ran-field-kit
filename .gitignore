.DS_Store
.tools/
__pycache__/
.venv/

!.gitignore
!results/
!results/integrated/
!results/integrated/**/

*.pyc

# Gate 3 raw / private evidence — never auto-commit
datasets/controlled/raw/**
datasets/controlled/raw-private/**
datasets/controlled/staged/**
!datasets/controlled/raw/.gitkeep
!datasets/controlled/raw-private/.gitkeep
!datasets/controlled/raw-private/README.md
!datasets/controlled/staged/.gitkeep
*.device-private.json
*.raw-session.json

# Sanitized sessions stay local until Edmund approves publication
datasets/controlled/sanitized/**
!datasets/controlled/sanitized/.gitkeep

# Calibration raw reports may include sanitized copies — keep measurement JSON local
results/calibration/**/sanitized_*.json
results/calibration/sanitized_*.json
results/calibration/**/_ignored_raw/
results/rehearsal/**/_ignored_raw/
results/rehearsal/**/sanitized_*.json
results/android/_ignored_local/
results/rehearsal/**/_ignored_sanitized/

# Release candidate archives (local only)
release/dist/**

# Ephemeral Gate 4 dry-run outputs
results/gate4/gate4-run-*/

# Large public-dataset downloads (re-fetch via make generalization-download)
datasets/external/source/nordicdat/**
!datasets/external/source/nordicdat/.gitkeep
!datasets/external/source/nordicdat/README.md
datasets/external/transformed/nordicdat/normalized_records.json
datasets/external/transformed/nordicdat/*.csv

# Paper build intermediates (keep main.pdf + reports)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/.paper_build.log

# Gate 1 runtime evidence outputs — never track timestamped runs/pending/accepted/rejected
gate1/evidence/accepted/*
gate1/evidence/pending/*
gate1/evidence/rejected/*
gate1/evidence/runs/*
!gate1/evidence/**/.gitkeep

# --- nvidia-6g NGC / secrets (never commit) ---
.env
.env.*
!.env.example
**/ngc_api_key*
**/*ngc*key*
**/*api_key*
*.pem
*.p12
secrets/
.secrets/
**/credentials.json
# Key material patterns (defense in depth)
**/ngc-api-token-*

# NVIDIA 6G / NGC — DO NOT put real keys here.
# Store API keys in macOS Keychain only:
#   security add-generic-password -a "$USER" -s "gunnchos-ngc-aodt" -w
#   security add-generic-password -a "$USER" -s "gunnchos-ngc-aerial" -w
# Auth (never echo the secret):
#   security find-generic-password -a "$USER" -s "gunnchos-ngc-aodt" -w | docker login nvcr.io -u '$oauthtoken' --password-stdin
#
# Optional non-secret paths (upstream clones live OUTSIDE this repo):
NVIDIA_6G_RESEARCH_ROOT=${HOME}/nvidia-6g-research
NVIDIA_UPSTREAM_ROOT=${HOME}/nvidia-6g-research/upstream
NGC_ORG_OR_CONTEXT=aerial-ov-digital-twin
GPU_WORKER_SSH_ALIAS=nvidia6g-worker
